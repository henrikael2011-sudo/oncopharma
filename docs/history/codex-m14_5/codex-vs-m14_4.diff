+import {readdirSync,readFileSync} from 'node:fs';import {createHash} from 'node:crypto';import {join} from 'node:path';
+export function sourceDigest(){const hash=createHash('sha256');function walk(dir){for(const e of readdirSync(dir,{withFileTypes:true}).sort((a,b)=>a.name.localeCompare(b.name))){if(['node_modules','.next','dist','.git','artifacts','test-results','docs'].includes(e.name))continue;const p=join(dir,e.name);if(e.isDirectory())walk(p);else if(/\.(tsx?|mjs|json|sql|sh|css|ya?ml)$/.test(p)&&!p.endsWith('next-env.d.ts')){hash.update(p);hash.update(readFileSync(p));}}}walk('.');return hash.digest('hex');}
