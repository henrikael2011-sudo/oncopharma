+import {expect} from '@playwright/test';
+import {createHmac,createDecipheriv} from 'node:crypto';
+import {createRemoteJWKSet,jwtVerify} from 'jose';
+import {existsSync,readFileSync,writeFileSync} from 'node:fs';
+export function otp(role:string){const secret=JSON.parse(process.env.ONCO_TEST_OTP_SECRETS||'{}')[role];const counter=Buffer.alloc(8);counter.writeBigUInt64BE(BigInt(Math.floor(Date.now()/30000)));const mac=createHmac('sha1',Buffer.from(secret,'utf8')).update(counter).digest();const at=mac[mac.length-1]&15;return String((mac.readUInt32BE(at)&0x7fffffff)%1000000).padStart(6,'0');}
+export async function freshOtp(role:string){
+ const path='artifacts/m14.5/otp-used-periods.json';const used=existsSync(path)?JSON.parse(readFileSync(path,'utf8')):{};
+ let period=Math.floor(Date.now()/30000);if(used[role]>=period){await new Promise(resolve=>setTimeout(resolve,30000-(Date.now()%30000)+500));period=Math.floor(Date.now()/30000);}
+ used[role]=period;writeFileSync(path,JSON.stringify(used));return otp(role);
+}
+export function tokenFromCookie(value:string){const b=Buffer.from(value,'base64url');const d=createDecipheriv('aes-256-gcm',Buffer.from(process.env.SESSION_ENCRYPTION_KEY!,'base64'),b.subarray(0,12));d.setAuthTag(b.subarray(12,28));return JSON.parse(Buffer.concat([d.update(b.subarray(28)),d.final()]).toString());}
+export async function login(page:any,role:string,app='clinical'){
+ const port=app==='care'?3001:app==='admin'?3003:3002;
+ let pkce=false;page.on('request',(r:any)=>{if(r.url().includes('/protocol/openid-connect/auth?')){const u=new URL(r.url());pkce=u.searchParams.get('code_challenge_method')==='S256'&&!!u.searchParams.get('code_challenge')&&!!u.searchParams.get('nonce')&&!!u.searchParams.get('state');}});
+ await page.goto(`http://localhost:${port}/api/auth/login`);
