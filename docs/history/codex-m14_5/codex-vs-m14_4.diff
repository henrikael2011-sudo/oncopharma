+const apps=[['care-web',3001,'/care'],['clinical-web',3002,'/clinical'],['admin-web',3003,'/']];
+function start(name,args,extra={}) {
+  const stream=createWriteStream(`${logdir}/server-${name}.log`);
+  const child=spawn(process.execPath,args,{env:{...env,...extra},stdio:['ignore','pipe','pipe']});
+  child.stdout.pipe(stream);child.stderr.pipe(stream);children.push(child);
+}
+start('api',['services/api/dist/main.js'],{PORT:'4000'});
+for(const [app,port,path] of apps)start(app,['node_modules/next/dist/bin/next','dev',`apps/${app}`,'-p',String(port),'-H','localhost'],{PORTAL_ORIGIN:`http://localhost:${port}`,AUTH_POST_LOGIN_PATH:path,OIDC_CLIENT_ID:process.env['OIDC_CLIENT_ID_'+app.split('-')[0].toUpperCase()]||env.OIDC_CLIENT_ID});
