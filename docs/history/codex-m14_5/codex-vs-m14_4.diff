+ await expect(page).toHaveURL(/localhost:3001\/care\?login=failed/);
+ expect((await page.context().cookies()).some(c=>c.name==='onco_session')).toBeFalsy();
+ await expect.poll(()=>fs.readFileSync('artifacts/m14.5/logs/keycloak-server.log','utf8').includes('pkce_verification_failed')).toBeTruthy();
+});
