+ for(const token of ['',s.token.slice(0,-8)+'tampered']){const r=await request.get('http://localhost:4000/v1/me',{headers:token?{Authorization:`Bearer ${token}`}:{}});expect(r.status()).toBe(401);}
+ const csrf=await page.context().request.post('http://localhost:3002/api/auth/logout',{headers:{Origin:'https://untrusted.example.invalid'},maxRedirects:0});expect(csrf.status()).toBe(403);
+ const workflow=await page.context().request.post('http://localhost:3002/api/workflow/patients/11111111-1111-4111-8111-111111111111/interventions',{headers:{Origin:'https://untrusted.example.invalid'},data:{note:'synthetic'}});expect(workflow.status()).toBe(403);
+ await page.goto('http://localhost:3002/api/auth/callback?code=synthetic-invalid&state=wrong');await expect(page).toHaveURL(/login=failed/);expect((await page.context().cookies()).some(c=>c.name==='onco_session')).toBeFalsy();
+ await login(page,'pharmacist');
+ const sessionCookie=(await page.context().cookies()).find(c=>c.name==='onco_session')!;const sess=tokenFromCookie(sessionCookie.value);
+ const wait=Math.max(0,sess.expiresAt-Date.now()+1500);console.log('Waiting for actual server-side session expiration: '+Math.ceil(wait/1000)+'s');await new Promise(resolve=>setTimeout(resolve,wait));
+ const expired=await page.context().request.get('http://localhost:3002/api/clinical/summary');expect(expired.status()).toBe(401);
+ await page.goto('http://localhost:3002/clinical');await expect(page.getByText('Faça login para acessar os dados profissionais.')).toBeVisible();
+ await page.screenshot({path:'artifacts/m14.5/screenshots/identity-expired.png',fullPage:true});
+});
+
+test('IdP rejects a wrong PKCE verifier for a real authorization code',async({page})=>{
+ test.setTimeout(90000);
+ await page.goto('http://localhost:3001/api/auth/login');
+ const cookie=(await page.context().cookies()).find(c=>c.name==='onco_login_flow')!;expect(cookie).toBeDefined();
+ const flow=tokenFromCookie(cookie.value);flow.verifier='invalid-verifier-'.repeat(4);
+ const iv=randomBytes(12),cipher=createCipheriv('aes-256-gcm',Buffer.from(process.env.SESSION_ENCRYPTION_KEY!,'base64'),iv);const encrypted=Buffer.concat([cipher.update(JSON.stringify(flow)),cipher.final()]);
+ // Negative fault injection: keep actual state/nonce, but make the BFF send an
+ // incorrect verifier for the challenge already registered with the real IdP.
+ // This never constructs an authenticated session or bypasses an authenticator.
+ await page.context().addCookies([{...cookie,value:Buffer.concat([iv,cipher.getAuthTag(),encrypted]).toString('base64url')}]);
