# NÃO insira dados reais. Não versione segredos.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
DATABASE_URL=postgresql://oncopharma:SUBSTITUA_POR_SENHA_FORTE@127.0.0.1:5432/oncopharma_dev
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
# OIDC deve ser um provedor real de desenvolvimento, com JWT de acesso, JWKS e MFA.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_MFA_ACR=
DEV_OIDC_SUB=
# Ativar somente para testes locais, nunca produção.
ALLOW_SYNTHETIC_API=false
DB_SSL=false

# M1.1 — Configuração do portal (servidor, nunca NEXT_PUBLIC)
PORTAL_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
# M14.5: end_session_endpoint do IdP (logout RP-initiated). Recomendado em homologação.
OIDC_END_SESSION_ENDPOINT=
# Gere 32 bytes aleatórios em base64: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
DEV_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
NEXT_PUBLIC_ALLOW_SYNTHETIC_UI=false

# M1.2: URL administrativa usada somente em migrações/seed/provisionamento.
DATABASE_URL_ADMIN=postgresql://oncopharma:SUBSTITUA_POR_SENHA_FORTE@127.0.0.1:5432/oncopharma_dev
# Senha da role da API (oncopharma_app), diferente da administrativa.
APP_DB_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE
# Após provisionar, alterar DATABASE_URL para postgresql://oncopharma_app:...@127.0.0.1:5432/oncopharma_dev
